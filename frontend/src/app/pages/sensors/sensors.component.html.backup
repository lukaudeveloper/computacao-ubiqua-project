<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4"><i class="bi bi-thermometer-half me-2"></i>Sensors</h2>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-plus-circle me-2"></i>Add Sensor</h5>
                </div>
                <div class="card-body">
                    <form (ngSubmit)="addSensor()" class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" [(ngModel)]="newSensor.name" name="name" placeholder="Sensor name" required>
                        </div>
                        <div class="col-md-6">
                            <label for="type" class="form-label">Type</label>
                            <select class="form-select" id="type" [(ngModel)]="newSensor.type" name="type" required>
                                <option value="">Select type</option>
                                <option value="temperature">Temperature</option>
                                <option value="humidity">Humidity</option>
                                <option value="air_quality">Air Quality</option>
                                <option value="noise">Noise</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="location" class="form-label">Location</label>
                            <input type="text" class="form-control" id="location" [(ngModel)]="newSensor.location" name="location" placeholder="Sensor location" required>
                        </div>
                        <div class="col-md-3">
                            <label for="threshold_min" class="form-label">Min Threshold</label>
                            <input type="number" class="form-control" id="threshold_min" [(ngModel)]="newSensor.threshold_min" name="threshold_min" placeholder="Min value" step="0.1">
                        </div>
                        <div class="col-md-3">
                            <label for="threshold_max" class="form-label">Max Threshold</label>
                            <input type="number" class="form-control" id="threshold_max" [(ngModel)]="newSensor.threshold_max" name="threshold_max" placeholder="Max value" step="0.1">
                        </div>
                        <div class="col-md-6">
                            <label for="color" class="form-label">Color</label>
                            <input type="color" class="form-control form-control-color" id="color" [(ngModel)]="newSensor.color" name="color">
                        </div>
                        <div class="col-md-6">
                            <label for="simulation_interval" class="form-label">Simulation Interval (seconds)</label>
                            <input type="number" class="form-control" id="simulation_interval" [(ngModel)]="newSensor.simulation_interval" name="simulation_interval" placeholder="Interval in seconds" min="5" max="3600">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Sensor</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="sensor-list">
        <h3>Sensor List</h3>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Thresholds</th>
                    <th>Interval</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr *ngFor="let sensor of sensors">
                    <td>{{ sensor.id }}</td>
                    <td>
                        <span class="color-dot" [style.background]="sensor.color"></span>
                        {{ sensor.name }}
                    </td>
                    <td>{{ sensor.type }}</td>
                    <td>{{ sensor.location }}</td>
                    <td>{{ sensor.is_active ? 'Ativo' : 'Inativo' }}</td>
                    <td>
                        {{ sensor.threshold_min ?? '—' }}
                        -
                        {{ sensor.threshold_max ?? '—' }}
                    </td>
                    <td>{{ sensor.simulation_interval }}s</td>
                    <td>
                        <button (click)="editSensor(sensor)">Edit</button>
                        <button (click)="deleteSensor(sensor.id)">Delete</button>
                        <button (click)="activateSensor(sensor)">
                            {{ sensor.is_active ? 'Deactivate' : 'Activate' }}
                        </button>
                        <button (click)="simulateSensor(sensor)" [disabled]="!sensor.is_active">
                            Simulate
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div *ngIf="simulationMessage" class="simulation-message">
        <p>{{ simulationMessage }}</p>
    </div>

    <div *ngIf="editingSensor" class="edit-sensor">
        <h3>Edit Sensor</h3>
        <form (ngSubmit)="updateSensor()">
            <input [(ngModel)]="editingSensor.name" name="name" placeholder="Name" required>
            <input [(ngModel)]="editingSensor.type" name="type" placeholder="Type" required>
            <input [(ngModel)]="editingSensor.location" name="location" placeholder="Location" required>
            <input [(ngModel)]="editingSensor.threshold_min" name="threshold_min" placeholder="Threshold min"
                type="number" step="0.1">
            <input [(ngModel)]="editingSensor.threshold_max" name="threshold_max" placeholder="Threshold max"
                type="number" step="0.1">
            <label>
                Color:
                <input [(ngModel)]="editingSensor.color" name="color" type="color">
            </label>
            <input [(ngModel)]="editingSensor.simulation_interval" name="simulation_interval"
                placeholder="Simulation interval (seconds)" type="number" min="5" max="3600">
            <button type="submit">Update</button>
            <button type="button" (click)="editingSensor = null">Cancel</button>
        </form>
    </div>
</div>
